# ===========================================
# Development Mode
# ===========================================
# Retained for compatibility with existing deployments.
# DEV_MODE=true

# Solana Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

DEX_FORK_TYPE="Uniswap V1"
FACTORY_ADDRESS=FUTARELBfJfQ8RDGhg1wdhddq1odMAJUePHFuBYfUxKq
ROUTER_ADDRESS=FUTARELBfJfQ8RDGhg1wdhddq1odMAJUePHFuBYfUxKq

# Server Configuration
PORT=3000
NODE_ENV=production
# Request timeout in milliseconds (default: 300000 = 5 minutes)
# SERVER_REQUEST_TIMEOUT=300000
# Keep-alive timeout in milliseconds (default: 300000 = 5 minutes)
# SERVER_KEEP_ALIVE_TIMEOUT=300000
# Number of reverse-proxy hops in front of this process (load balancer, ingress).
# Required for per-IP rate limiting to see real client IPs instead of the proxy's.
# 0 = no proxy. Use the exact hop count — never more than the real number.
# TRUST_PROXY_HOPS=1

# ===========================================
# Trusted API Keys (Higher Rate Limits)
# ===========================================
# Partners send these via the 'X-API-Key' header to receive an elevated limit.
# Comma-separated, opaque secrets (e.g. `openssl rand -hex 32`). Each key gets
# its own bucket. Requests with an unrecognized key return 401 Unauthorized.
# TRUSTED_API_KEYS=
# Per-bucket limit per minute for trusted keys (default: 600).
# TRUSTED_RATE_LIMIT_MAX=600

# Blockchain Data Cache TTL in milliseconds (default: 55000 = 55 seconds).
# Consumers poll about once per minute, so the default keeps every poll fresh
# while running the full DAO RPC scan roughly once per minute.
# Lower = more real-time prices but more RPC calls.
# CACHE_TICKERS_TTL=55000

PROTOCOL_FEE_RATE=0.005

EXCLUDED_DAOS=DMB74TZgN7Rqfwtqqm3VQBgKBb2WYPdBqVtHbvB4LLeV,AE7jPb9jYzbUE5GYJToKvXaRkJL2Q7Mm3Ek6KqyBGuxe,E3BjsvLSFqUqVtDP76qMw4QbETkxvqvg8RTSbRZxWCK4,CnUUCGbSrAoaJniPifRU8zHRZ6e5uGRVSpCEj2WMeeSv,CLoqV77NtkbrsvtCRDP1vdYxgPZua3nnh7gCNPLzDQQ8,CJCgDqiDtkQvwXT2iiyY7QVajKLH3VRVbcsNQgtttrHn,651uV1hcd7SprwwkumFfkWtx5WrnD53awpjduGtGsHzS,4rW6iVKUq1RWYQ1VBTrjvP9FL4G3Sn7mBj7Yg12kuckv,Eo1BLMVRLJspjP5dDnwzK1m6FxMUcQDG6kDA8CjWPzRW,CTYxPujxrXiiqwG3gSBVNKuBk8u7mPG9qVMUc4aT1L8u,EbcsPbXZa81xUunDSmzYrcAWGURxcZB6BTkgzqvNJBZH,BgNq2V6vea2C7Z3cZhDUJTbmN4Y9bKG6dfEPhH19J7Fb,DHjQLd6LCM4yzZ9e8eabyGofDJLjbouqpuX8wh1rQuBs,BQjNtXjZB7b9WrqgJZQWfR52T1MqZoqMELAoombywDi8,j6Hx7bdAzcj1NsoRBqdafFuRkgEU48QeZ1i5NVXz9fF,AE7jPb9jYzbUE5GYJToKvXaRkJL2Q7Mm3Ek6KqyBGuxe

# ===========================================
# Served ETL Database Configuration (the ONLY database this API uses)
# ===========================================
# Required for /api/tickers, /api/market-data, and DexScreener routes.
# FRONTEND_READER_PG_URL takes precedence; EXTERNAL_DATABASE_URL is the fallback.
# FRONTEND_READER_PG_URL=postgresql://readonly:password@host:5432/database
# EXTERNAL_DATABASE_URL=postgresql://readonly:password@host:5432/database
# EXTERNAL_DATABASE_SSL=true
# PEM CA certificate CONTENT (not a path) for verifying a private-CA server cert.
# With SSL on and no CA cert, system CAs are used for verification.
# EXTERNAL_DATABASE_CA_CERT=
# Explicit opt-out of TLS server verification (self-signed certs, legacy setups).
# Encrypts but does NOT authenticate the server — stopgap only.
# EXTERNAL_DATABASE_SSL_NO_VERIFY=true

# ===========================================
# Heartbeat (background self-check)
# ===========================================
# Cadence of the served-DB connectivity/freshness/contract self-check.
# 0 disables the heartbeat. Default: 60000 (1 minute).
# HEARTBEAT_INTERVAL_MS=60000
# Alert when the newest user_pool swap is older than this many seconds.
# 0 disables the staleness alert. Default: 21600 (6 hours).
# HEARTBEAT_MAX_DATA_AGE_SECONDS=21600

# ===========================================
# Alerts
# ===========================================
# Telegram webhook relay for heartbeat and serving alerts.
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_SECRET=
